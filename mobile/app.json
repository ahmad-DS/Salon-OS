{
  "expo": {
    "name": "MODERNE D'AURA SALON",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/salon-icon3.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/salon-icon3.png",
        "backgroundColor": "#F9F8F6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.expoblankmind.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "baseUrl": "/",
      "favicon": "./assets/salon-icon3.png",
      "themeColor": "#F9F8F6",
      "backgroundColor": "#F9F8F6"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e882585-1836-42ba-9120-b7060e1edcc8"
      }
    }
  }
}
